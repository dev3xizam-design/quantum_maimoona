      "notes": "Stable filename. City, county, transit and special district codes; the Comptroller also publishes county-rates.xlsx, transit-rates.xlsx and spd-rates.xlsx alongside it."
    },
    {
      "id": "az-adortpt",
      "kind": "table",
      "state": "AZ",
      "name": "ADOR TPT rate table",
      "status": "ready",
