{
  "_comment": "Where each state's jurisdiction codes come from. Government sources only. A quarterly file usually changes its name (pub17000726.xlsx, Q426_..._rates-alpha.xlsx), so most entries DISCOVER the current file from an index page instead of hardcoding a link. 'status': ready = downloaded and parsed by this runner; adapter-needed = the source is known and recorded here, but its parser is not written yet, so the state keeps the data loaded from the first build until someone adds one.",
  "_settings": {
    "userAgent": "Quantum tax automation (Maximum Vapor Inc.) - jurisdiction code refresh",
    "timeoutSeconds": 120,
    "retries": 3,
    "politeDelaySeconds": 2
  },
  "sources": [
    {
      "id": "sst",
      "kind": "sst",
      "name": "Streamlined Sales Tax rate files",
      "status": "ready",
      "indexUrl": "https://www.streamlinedsalestax.org/ratesandboundry/Rates",
      "linkPattern": "(?P<state>[A-Z]{2})R(?P<year>\\d{4})Q(?P<quarter>\\d)[A-Za-z0-9]*\\.(csv|zip|CSV|ZIP)",
      "states": [
        "AR",
        "GA",
        "IA",
        "IN",
        "KS",
        "KY",
        "MI",
        "MN",
        "NC",
        "ND",
        "NE",
        "NJ",
        "NV",
        "OH",
        "OK",
        "RI",
        "SD",
        "TN",
        "UT",
        "VT",
        "WA",
        "WI",
        "WV",
        "WY"
      ],
      "notes": "One directory listing, one file per state, one format: state FIPS, jurisdiction type (45 state, 00 county, 01 city, others special), jurisdiction FIPS, rates, begin and end dates. Names come from the Census county and place files."
    },
    {
      "id": "al-aldor",
      "kind": "table",
      "state": "AL",
      "name": "ALDOR local tax rates",
      "status": "ready",
      "fileUrl": "https://www.revenue.alabama.gov/wp-content/uploads/2024/03/taxrates_current.csv",
      "format": "csv",
      "codeSystem": "ALDOR locality code",
      "notes": "Stable filename, updated in place. One row per locality per tax type (sales, sellers use, consumers use)."
    },
    {
      "id": "tx-comptroller",
      "kind": "table",
      "state": "TX",
      "name": "Texas Comptroller city rates",
      "status": "ready",
      "fileUrl": "https://comptroller.texas.gov/taxes/sales/docs/city-rates.xlsx",
      "format": "xlsx",
