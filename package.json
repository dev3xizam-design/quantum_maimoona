{
  "name": "maxvapor-tax",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run jurisdictions:files && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test scripts/test-engine.ts",
    "test:integration": "tsx --conditions=react-server --test scripts/test-integration.ts",
    "test:all": "npm test && npm run test:connectors && npm run test:integration",
    "db:jurisdictions": "tsx scripts/load-jurisdictions.ts",
    "jurisdictions:files": "tsx scripts/load-jurisdictions.ts --files",
    "test:connectors": "tsx --conditions=react-server --test scripts/test-connectors.ts"
  },
  "dependencies": {
    "@neon/config": "^1.3.2",
    "@neon/env": "^1.2.3",
    "@types/mailparser": "^3.9.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "imapflow": "^2.4.2",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "mailparser": "^3.9.39",
    "next": "16.3.4",
    "nodemailer": "^10.1.1",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
